{
  "name": "latentscore",
  "version": "0.1.0",
  "description": "Local procedural ambient music synthesizer and reactive mood engine for JavaScript and TypeScript. Zero runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "music",
    "ambient",
    "synthesizer",
    "dsp",
    "web-audio",
    "generative-music",
    "audio",
    "procedural"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/prabal-rje/latentscore.git",
    "directory": "packages/latentscore"
  },
  "homepage": "https://github.com/prabal-rje/latentscore",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/esm/browser.d.ts",
        "default": "./dist/esm/browser.js"
      },
      "require": {
        "types": "./dist/cjs/browser.d.ts",
        "default": "./dist/cjs/browser.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "spec",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }, null, 2) + '\\n')\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "test": "npm run build && node --test test/latentscore.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
