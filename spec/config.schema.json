{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LatentScore MusicConfig",
  "spec_version": 1,
  "sample_rate": 44100,
  "schema_version": 1,
  "defaults": {
    "schema_version": 1,
    "tempo": "medium",
    "root": "c",
    "mode": "minor",
    "brightness": "medium",
    "space": "medium",
    "density": 5,
    "bass": "drone",
    "pad": "warm_slow",
    "melody": "contemplative",
    "rhythm": "minimal",
    "texture": "shimmer",
    "accent": "bells",
    "motion": "medium",
    "attack": "medium",
    "stereo": "medium",
    "depth": false,
    "echo": "medium",
    "human": "robotic",
    "grain": "clean",
    "melody_engine": "pattern",
    "phrase_len_bars": 4,
    "melody_density": 0.45,
    "syncopation": 0.2,
    "swing": 0.0,
    "motif_repeat_prob": 0.5,
    "step_bias": 0.75,
    "chromatic_prob": 0.05,
    "cadence_strength": 0.65,
    "register_min_oct": 4,
    "register_max_oct": 6,
    "tension_curve": "arc",
    "harmony_style": "auto",
    "chord_change_bars": 1,
    "chord_extensions": "triads"
  },
  "enums": {
    "tempo": ["very_slow", "slow", "medium", "fast", "very_fast"],
    "root": ["c", "c#", "d", "d#", "e", "f", "f#", "g", "g#", "a", "a#", "b"],
    "mode": ["major", "minor", "dorian", "mixolydian"],
    "brightness": ["very_dark", "dark", "medium", "bright", "very_bright"],
    "space": ["dry", "small", "medium", "large", "vast"],
    "density": [2, 3, 4, 5, 6],
    "bass": ["drone", "sustained", "pulsing", "walking", "fifth_drone", "sub_pulse", "octave", "arp_bass"],
    "pad": ["warm_slow", "dark_sustained", "cinematic", "thin_high", "ambient_drift", "stacked_fifths", "bright_open"],
    "melody": ["procedural", "contemplative", "rising", "falling", "minimal", "ornamental", "arp_melody", "contemplative_minor", "call_response", "heroic"],
    "rhythm": ["none", "minimal", "heartbeat", "soft_four", "hats_only", "electronic", "kit_light", "kit_medium", "military", "tabla_essence", "brush"],
    "texture": ["none", "shimmer", "shimmer_slow", "vinyl_crackle", "breath", "stars", "glitch", "noise_wash", "crystal", "pad_whisper"],
    "accent": ["none", "bells", "pluck", "chime", "bells_dense", "blip", "blip_random", "brass_hit", "wind", "arp_accent", "piano_note"],
    "motion": ["static", "slow", "medium", "fast", "chaotic"],
    "attack": ["soft", "medium", "sharp"],
    "stereo": ["mono", "narrow", "medium", "wide", "ultra_wide"],
    "echo": ["none", "subtle", "medium", "heavy", "infinite"],
    "human": ["robotic", "tight", "natural", "loose", "drunk"],
    "grain": ["clean", "warm", "gritty"],
    "melody_engine": ["pattern", "procedural"],
    "phrase_len_bars": [2, 4, 8],
    "tension_curve": ["arc", "ramp", "waves"],
    "harmony_style": ["auto", "pop", "jazz", "cinematic", "ambient"],
    "chord_extensions": ["triads", "sevenths", "lush"]
  },
  "label_maps": {
    "tempo": { "very_slow": 0.15, "slow": 0.3, "medium": 0.5, "fast": 0.7, "very_fast": 0.9 },
    "brightness": { "very_dark": 0.1, "dark": 0.3, "medium": 0.5, "bright": 0.7, "very_bright": 0.9 },
    "space": { "dry": 0.1, "small": 0.3, "medium": 0.5, "large": 0.7, "vast": 0.95 },
    "motion": { "static": 0.1, "slow": 0.3, "medium": 0.5, "fast": 0.7, "chaotic": 0.9 },
    "stereo": { "mono": 0.0, "narrow": 0.25, "medium": 0.5, "wide": 0.75, "ultra_wide": 1.0 },
    "echo": { "none": 0.0, "subtle": 0.25, "medium": 0.5, "heavy": 0.75, "infinite": 0.95 },
    "human": { "robotic": 0.0, "tight": 0.15, "natural": 0.3, "loose": 0.5, "drunk": 0.8 },
    "melody_density": { "very_sparse": 0.15, "sparse": 0.3, "medium": 0.5, "busy": 0.7, "very_busy": 0.85 },
    "syncopation": { "straight": 0.0, "light": 0.2, "medium": 0.5, "heavy": 0.8 },
    "swing": { "none": 0.0, "light": 0.2, "medium": 0.5, "heavy": 0.8 },
    "motif_repeat_prob": { "rare": 0.2, "sometimes": 0.5, "often": 0.8 },
    "step_bias": { "step": 0.9, "balanced": 0.7, "leapy": 0.4 },
    "chromatic_prob": { "none": 0.0, "light": 0.05, "medium": 0.12, "heavy": 0.25 },
    "cadence_strength": { "weak": 0.3, "medium": 0.6, "strong": 0.9 },
    "chord_change_bars": { "very_slow": 4, "slow": 2, "medium": 1, "fast": 1 }
  },
  "bpm_formula": {
    "min_bpm": 55.0,
    "span_bpm": 110.0
  },
  "rules": {
    "config_extras": "allow",
    "update_extras": "forbid",
    "wav_channels": { "mono_threshold_stereo": 0.05, "mono": 1, "stereo": 2 }
  }
}
